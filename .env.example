# --- Database ---
# Used by docker-compose for the postgres container
POSTGRES_USER=temart
POSTGRES_PASSWORD=temart
POSTGRES_DB=temart

# Connection string used by the backend when run locally (make run).
# The docker-compose Postgres is published on host port 5433 to avoid
# clashing with a native PostgreSQL on 5432. Inside docker-compose the backend
# overrides this to use host "postgres:5432".
DATABASE_URL=postgres://temart:temart@localhost:5433/temart?sslmode=disable

# --- Server ---
PORT=8080
# Comma-separated list of allowed CORS origins (the web frontend).
CORS_ORIGIN=http://localhost:5173

# --- Auth ---
# CHANGE THIS in production. Used to sign JWTs.
JWT_SECRET=dev-secret-change-me
ACCESS_TTL=15m
REFRESH_TTL=168h
# Set to true only when served over HTTPS (Secure cookie flag).
COOKIE_SECURE=false

# --- Bootstrap platform superadmin (администратор платформы) ---
# On first start, if no superadmin exists, one is created from these. This is
# the account that manages all clinics and creates clinic owners.
SUPERADMIN_NAME=Администратор платформы
SUPERADMIN_EMAIL=admin@temart.local
SUPERADMIN_PASSWORD=changeme123

# --- Serve built frontend from the Go server (production) ---
# Directory with the built SPA (web/dist). Leave empty in dev (Vite serves it).
# The Docker image sets this to /app/web automatically.
WEB_DIR=
