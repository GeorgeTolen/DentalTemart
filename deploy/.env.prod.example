# Скопируйте в файл `.env` рядом с docker-compose.prod.yml на сервере и заполните
# СИЛЬНЫМИ значениями. Этот файл (.env) НЕ коммитить.
#
# Сгенерировать секрет:  openssl rand -base64 48

# --- База данных ---
POSTGRES_USER=temart
POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_СИЛЬНЫЙ_ПАРОЛЬ
POSTGRES_DB=temart

# --- Подпись JWT (обязательно сменить!) ---
JWT_SECRET=ЗАМЕНИТЕ_НА_ДЛИННУЮ_СЛУЧАЙНУЮ_СТРОКУ

# --- Администратор платформы (создаётся при первом запуске) ---
SUPERADMIN_NAME=Администратор платформы
SUPERADMIN_EMAIL=admin@temart.kz
SUPERADMIN_PASSWORD=ЗАМЕНИТЕ_НА_СИЛЬНЫЙ_ПАРОЛЬ

# --- Образ backend (из GitHub Container Registry) ---
# Имя всегда строчными буквами.
IMAGE=ghcr.io/georgetolen/dentaltemart:latest
